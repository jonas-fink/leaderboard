{
    "name": "leaderboard-server",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "node --env-file=.env --watch src/index.ts",
        "start": "node --env-file=.env src/index.ts",
        "seed": "node --env-file=.env src/seed.ts",
        "tournament:delete": "node --env-file=.env src/delete-tournament.ts",
        "test": "node --test 'src/**/*.check.ts'"
    },
    "imports": {
        "#config": "./src/config/index.ts",
        "#content": "./src/content/index.ts",
        "#db": "./src/db/index.ts",
        "#models": "./src/models/index.ts",
        "#schemas": "./src/schemas/index.ts",
        "#types": "./src/types/index.ts",
        "#utils": "./src/utils/index.ts",
        "#services": "./src/services/index.ts",
        "#services/*": "./src/services/*.ts",
        "#controllers": "./src/controllers/index.ts",
        "#routes": "./src/routes/index.ts",
        "#middleware": "./src/middleware/index.ts",
        "#realtime": "./src/realtime/index.ts"
    },
    "dependencies": {
        "express": "^5.1.0",
        "mongoose": "^9.9.3",
        "multer": "^2.3.0",
        "sharp": "^0.35.4",
        "socket.io": "^4.8.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/multer": "^2.2.0",
        "@types/node": "^26.2.0",
        "typescript": "^7.0.2"
    }
}
