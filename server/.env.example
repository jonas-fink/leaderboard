MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/
MONGODB_DB=leaderboard
PORT=4000
# Schlüssel für die Signatur des Sitzungs-Tokens (specs/002-benutzerkonten).
# Ein Zufallswert, einmal je Umgebung eingefügt:
#   node -e "console.log(require('node:crypto').randomBytes(18).toString('base64url'))"
SESSION_SECRET=bitte-durch-einen-zufallswert-ersetzen
# development | production — steuert u.a. das Secure-Flag des Sitzungs-Cookies.
NODE_ENV=development
# Verzeichnis für hochgeladene Avatare und Banner, relativ zu server/
UPLOAD_DIR=uploads

# Nur im Container: Pfad zum gebauten Frontend (dist). Lokal leer lassen.
# CLIENT_DIR=/app/dist
