MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/
MONGODB_DB=leaderboard
PORT=4000
# Der einzige Zugriffsschutz, seit alles über den Funnel läuft (PROJEKT.md §9).
# Kein gewählter PIN — ein Zufallswert, einmal je Gerät eingefügt:
#   node -e "console.log(require('node:crypto').randomBytes(18).toString('base64url'))"
ADMIN_PIN=bitte-durch-einen-zufallswert-ersetzen
# Verzeichnis für hochgeladene Avatare und Banner, relativ zu server/
UPLOAD_DIR=uploads

# Nur im Container: Pfad zum gebauten Frontend (dist). Lokal leer lassen.
# CLIENT_DIR=/app/dist
